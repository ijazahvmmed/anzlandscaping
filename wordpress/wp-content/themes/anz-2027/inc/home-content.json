  "faq": [
    {
      "question": "What landscaping services does ANZ provide?",
      "answer": "ANZ provides terrace gardens, vertical gardens, villa landscaping, pergola and fabrication, commercial landscaping and garden maintenance. Office plant rental and other planting services are also available."
    },
    {
      "question": "Who does ANZ Landscaping work with?",
      "answer": "ANZ works on residential, commercial and corporate spaces, including corporate offices, hotels, real estate developments and educational institutions."
    },
    {
      "question": "Where is ANZ Landscaping based?",
      "answer": "ANZ Landscaping is based in Indiranagar, Bengaluru, Karnataka. Contact the team with your site location to discuss service availability and project requirements."
    },
    {
      "question": "Does ANZ provide ongoing garden maintenance?",
      "answer": "Yes. ANZ provides regular garden care, pruning and upkeep. Contact the team to discuss the tasks and maintenance schedule your landscape needs."
    },
    {
      "question": "How can I request a landscaping quote?",
      "answer": "Use the enquiry form or call +91 98452 92729. Share your location, the service you need and your budget so the team can discuss the next steps."
    }
  ],
